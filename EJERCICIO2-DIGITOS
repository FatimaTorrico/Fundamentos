#include <iostream>
using namespace std;

int main()
{
    int n, cp, d, opcion;
    do {
        cp = 0;
        cout << "Ingresar los numeros enteros:";
        cin >> n;
        if (n == 0) {
            cp = 1;
        }
        else {
            while (n!= 0) {
                d = n % 10;
                if (d % 2 == 0) {
                    cp++;
                }
                n = n / 10;
            }
        }
        cout << "La cantidad de digitos pares es:" << cp << endl;
        cout << "-----------------------------------" << endl;
        cout << "¿Desea continuar? (SI=1 / NO=0):"<<endl;
        cin>> opcion;
        cout << "------------------------------------" << endl;
    }
        while (opcion = 1);
                

    return 0;
}
