#include <iostream>
#include <math.h>
using namespace std;

int main()
{
   double d;
   float x1,y1,x2,y2;
   cout<<"Ingresa el valor de x1:"<<endl;
   cin>>x1;
   cout<<"Ingresa el valor de y1:"<<endl;
   cin>>y1;
   cout<<"Ingresa el valor de x2:"<<endl;
