#include <iostream>
#include <string>
using namespace std;

// VECTORES
string usuarios[100], claves[100];
int totalUsuarios = 0;

string nombres[100], fechas[100], cis[100];
string direcciones[100], telefonos[100];
int totalPersonas = 0;

// PROTOTIPOS
bool validarFecha(string fecha);

void registrarUsuario();
void listarUsuarios();
void modificarUsuario();
void borrarUsuario();
bool login();

void registrarPersona();
void listarPersonas();
void modificarPersona();
void borrarPersona();
void menuPersonas();

// MAIN
int main() {
    string op;

    do {
        cout << "\n===== SISTEMA DE LOGIN =====\n";
        cout << "1. Registrar usuario\n";
        cout << "2. Listar usuarios\n";
        cout << "3. Modificar usuario\n";
        cout << "4. Borrar usuario\n";
        cout << "5. Iniciar sesion\n";
        cout << "6. Salir\n";

        cout << "Seleccione una opcion: ";
        getline(cin, op);

        if (op == "1")
            registrarUsuario();
        else if (op == "2")
            listarUsuarios();
        else if (op == "3")
            modificarUsuario();
        else if (op == "4")
            borrarUsuario();
        else if (op == "5") {
            if (login())
                menuPersonas();
        }
        else if (op == "6")
            cout << "Gracias por utilizar el sistema.\n";
        else
            cout << "Opcion incorrecta.\n";

    } while (op != "6");

    return 0;
}

// VALIDAR FECHA
bool validarFecha(string fecha) {

    if (fecha.length() != 10)
        return false;

    if (fecha[2] != '/' || fecha[5] != '/')
        return false;

    for (int i = 0; i < 10; i++) {
        if (i != 2 && i != 5) {
            if (fecha[i] < '0' || fecha[i] > '9')
                return false;
        }
    }

    int dia = (fecha[0] - '0') * 10
            + (fecha[1] - '0');

    int mes = (fecha[3] - '0') * 10
            + (fecha[4] - '0');

    int anio = (fecha[6] - '0') * 1000
             + (fecha[7] - '0') * 100
             + (fecha[8] - '0') * 10
             + (fecha[9] - '0');

    if (anio < 1)
        return false;

    if (mes < 1 || mes > 12)
        return false;

    int dias;

    if (mes == 2) {
        if (anio % 400 == 0 ||
           (anio % 4 == 0 && anio % 100 != 0))
            dias = 29;
        else
            dias = 28;
    }
    else if (mes == 4 || mes == 6 ||
             mes == 9 || mes == 11)
        dias = 30;
    else
        dias = 31;

    if (dia < 1 || dia > dias)
        return false;

    return true;
}

// REGISTRAR USUARIO
void registrarUsuario() {
    string usuario, clave;

    cout << "\n--- REGISTRAR USUARIO ---\n";
    cout << "Ingrese usuario: ";
    getline(cin, usuario);

    for (int i = 0; i < totalUsuarios; i++) {
        if (usuarios[i] == usuario) {
            cout << "El usuario ya existe.\n";
            return;
        }
    }

    if (totalUsuarios >= 100) {
        cout << "No hay espacio para mas usuarios.\n";
        return;
    }

    cout << "Ingrese contrasena: ";
    getline(cin, clave);

    usuarios[totalUsuarios] = usuario;
    claves[totalUsuarios] = clave;
    totalUsuarios++;

    cout << "Usuario registrado correctamente.\n";
}

// LISTAR USUARIOS
void listarUsuarios() {
    cout << "\n--- LISTA DE USUARIOS ---\n";

    if (totalUsuarios == 0) {
        cout << "No hay usuarios registrados.\n";
    }
    else {
        for (int i = 0; i < totalUsuarios; i++) {
            cout << "\nUsuario Nro: " << i + 1;
            cout << "\nUsuario: " << usuarios[i] << "\n";
        }
    }
}

// MODIFICAR USUARIO
void modificarUsuario() {
    string nombre, nuevo;

    cout << "\n--- MODIFICAR USUARIO ---\n";
    cout << "Ingrese el usuario que desea modificar: ";
    getline(cin, nombre);

    for (int i = 0; i < totalUsuarios; i++) {
        if (usuarios[i] == nombre) {

            cout << "Nuevo nombre de usuario: ";
            getline(cin, nuevo);

            for (int j = 0; j < totalUsuarios; j++) {
                if (j != i && usuarios[j] == nuevo) {
                    cout << "El usuario ya existe.\n";
                    return;
                }
            }

            usuarios[i] = nuevo;

            cout << "Nueva contrasena: ";
            getline(cin, claves[i]);

            cout << "Usuario modificado correctamente.\n";
            return;
        }
    }

    cout << "Usuario no encontrado.\n";
}

// BORRAR USUARIO
void borrarUsuario() {
    string nombre;

    cout << "\n--- BORRAR USUARIO ---\n";
    cout << "Ingrese el usuario que desea eliminar: ";
    getline(cin, nombre);

    for (int i = 0; i < totalUsuarios; i++) {
        if (usuarios[i] == nombre) {

            for (int j = i; j < totalUsuarios - 1; j++) {
                usuarios[j] = usuarios[j + 1];
                claves[j] = claves[j + 1];
            }

            totalUsuarios--;

            cout << "Usuario eliminado correctamente.\n";
            return;
        }
    }

    cout << "Usuario no encontrado.\n";
}

// INICIAR SESION
bool login() {
    string usuario, clave;

    cout << "\n--- INICIAR SESION ---\n";
    cout << "Usuario: ";
    getline(cin, usuario);

    cout << "Contrasena: ";
    getline(cin, clave);

    for (int i = 0; i < totalUsuarios; i++) {
        if (usuarios[i] == usuario &&
            claves[i] == clave) {
            cout << "Bienvenido " << usuario << "\n";
            return true;
        }
    }

    cout << "Usuario o contrasena incorrectos.\n";
    return false;
}

// REGISTRAR PERSONA
void registrarPersona() {
    cout << "\n--- REGISTRAR PERSONA ---\n";

    if (totalPersonas >= 100) {
        cout << "No hay espacio para mas personas.\n";
        return;
    }

    int i = totalPersonas;

    cout << "Nombre: ";
    getline(cin, nombres[i]);

    do {
        cout << "Fecha de nacimiento (DD/MM/AAAA): ";
        getline(cin, fechas[i]);

        if (!validarFecha(fechas[i]))
            cout << "Fecha incorrecta. Ingrese una fecha real.\n";

    } while (!validarFecha(fechas[i]));

    cout << "CI: ";
    getline(cin, cis[i]);

    cout << "Direccion: ";
    getline(cin, direcciones[i]);

    cout << "Telefono: ";
    getline(cin, telefonos[i]);

    totalPersonas++;

    cout << "Persona registrada correctamente.\n";
}

// LISTAR PERSONAS
void listarPersonas() {
    cout << "\n--- LISTA DE PERSONAS ---\n";

    if (totalPersonas == 0) {
        cout << "No existen personas registradas.\n";
    }
    else {
        for (int i = 0; i < totalPersonas; i++) {
            cout << "\nPersona Nro: " << i + 1;
            cout << "\nNombre: " << nombres[i];
            cout << "\nFecha de nacimiento: " << fechas[i];
            cout << "\nCI: " << cis[i];
            cout << "\nDireccion: " << direcciones[i];
            cout << "\nTelefono: " << telefonos[i] << "\n";
        }
    }
}

// MODIFICAR PERSONA
void modificarPersona() {
    string ci;

    cout << "\n--- MODIFICAR PERSONA ---\n";
    cout << "Ingrese el CI de la persona: ";
    getline(cin, ci);

    for (int i = 0; i < totalPersonas; i++) {
        if (cis[i] == ci) {

            cout << "Nuevo nombre: ";
            getline(cin, nombres[i]);

            do {
                cout << "Nueva fecha de nacimiento (DD/MM/AAAA): ";
                getline(cin, fechas[i]);

                if (!validarFecha(fechas[i]))
                    cout << "Fecha incorrecta. Ingrese una fecha real.\n";

            } while (!validarFecha(fechas[i]));

            cout << "Nuevo CI: ";
            getline(cin, cis[i]);

            cout << "Nueva direccion: ";
            getline(cin, direcciones[i]);

            cout << "Nuevo telefono: ";
            getline(cin, telefonos[i]);

            cout << "Persona modificada correctamente.\n";
            return;
        }
    }

    cout << "Persona no encontrada.\n";
}

// BORRAR PERSONA
void borrarPersona() {
    string ci;

    cout << "\n--- BORRAR PERSONA ---\n";
    cout << "Ingrese el CI: ";
    getline(cin, ci);

    for (int i = 0; i < totalPersonas; i++) {
        if (cis[i] == ci) {

            for (int j = i; j < totalPersonas - 1; j++) {
                nombres[j] = nombres[j + 1];
                fechas[j] = fechas[j + 1];
                cis[j] = cis[j + 1];
                direcciones[j] = direcciones[j + 1];
                telefonos[j] = telefonos[j + 1];
            }

            totalPersonas--;

            cout << "Persona eliminada correctamente.\n";
            return;
        }
    }

    cout << "Persona no encontrada.\n";
}

