    string op;

    do {
        cout << "\n===== MENU DE PERSONAS =====\n";
        cout << "1. Registrar persona\n";
        cout << "2. Listar personas\n";
        cout << "3. Modificar persona\n";
        cout << "4. Borrar persona\n";
        cout << "5. Cerrar sesion\n";

        cout << "Seleccione una opcion: ";
        getline(cin, op);

        if (op == "1")
            registrarPersona();
        else if (op == "2")
            listarPersonas();
        else if (op == "3")
            modificarPersona();
        else if (op == "4")
            borrarPersona();
        else if (op == "5")
            cout << "Sesion cerrada.\n";
        else
            cout << "Opcion incorrecta.\n";

    } while (op != "5");
}
