        break;
         case 0: 
          cout<<"|Saliste del menu|"<<endl;
        break;
        default:
           cout<<"OPCION INVALIDA"<<endl;
    }
    }while(opcion!=0);
    cout<<" ITEM                      CANTIDAD  TOTAL PARCIAL"<<endl;
