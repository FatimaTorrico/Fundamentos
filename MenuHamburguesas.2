#include <iostream>
using namespace std;
int main()
{
    int cantidad,opcion,canham=0,canhamq=0,canpapas=0,canso=0;
    float totalparcial,precio,totalham=0,totalhamq=0,totalpapas=0,totalso=0;
    do{
    cout<<"----------Menu---------"<<endl;
    cout<<"1.Hamburguesa  Bs.3"<<endl;
