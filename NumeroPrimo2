#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    int opcion;
    do{
    int n, cont = 2, cont2 = 0;
    bool flag = true;
    cout << "Ingrese el numero de primos a generar: " << endl;
    cin >> n;
    while (cont2 <n)
    {
        flag = true;
        for (int i = 2; i <= sqrt(cont); i++){
            if (cont % i == 0) {
                flag = false;  
                break;
            }
        }
        if (flag)
        {
            cout << cont << ",";
            cont2++;
        }
        cont++;
    }
    cout<<endl;
    cout<<"-----------------------------"<<endl;
    cout<<"¿Desea continuar?(1=SI/0=NO):"<<endl;
    cin>>opcion;
    }
    while(opcion==1);
    return 0;
 }
         
